    <string name="guide_eyebrow">GAME SPACE  /  GUIDE</string>
    <string name="guide_title">Smoother gaming</string>
    <string name="guide_intro">Set the mode on your phone and check the result yourself. Menu names may vary by firmware.</string>
    <string name="guide_1_title">Enable the unlock</string>
    <string name="guide_1_body">Tap the main button and wait for confirmation.</string>
    <string name="guide_2_title">Launch a game</string>
    <string name="guide_2_body">Open it from the list or as usual.</string>
    <string name="guide_3_title">Open the gaming panel</string>
    <string name="guide_3_body">Open the REDMAGIC / Game Space panel in the game.</string>
    <string name="guide_4_title">Open image settings</string>
    <string name="guide_4_body">Find and open the “Enhanced image quality” tile with a similar icon.</string>
    <string name="guide_5_title">Choose the frame rate</string>
    <string name="guide_5_body">In the Frame rate row, select High or Ultra high. Image quality is a separate row above it.</string>
    <string name="guide_6_title">Check the result</string>
    <string name="guide_6_body">Check smoothness and FPS. Optionally save your result for the game in this app.</string>
    <string name="guide_disclaimer">The app cannot automatically confirm that REDMAGIC generates intermediate frames.</string>
